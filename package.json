{
  "name": "loops-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "feed:latest": "node scripts/prepare-latest-feed.mjs",
    "feed:weekly": "node scripts/create-weekly-feed.mjs",
    "start": "next start",
    "sync:loops": "node scripts/sync-georgeloops.mjs",
    "sync:georgeloops": "node scripts/sync-georgeloops.mjs",
    "validate:loops": "node scripts/sync-georgeloops.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.15.34",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}

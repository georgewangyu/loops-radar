{
  "crons": [
    {
      "path": "/api/cron/radar-leads-heartbeat",
      "schedule": "17 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "loops-radar.vercel.app"
        }
      ],
      "destination": "https://loopsradar.snackoverflowgeorge.com",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "loops-radar.vercel.app"
        }
      ],
      "destination": "https://loopsradar.snackoverflowgeorge.com/:path*",
      "permanent": true
    }
  ]
}
